# ============================================================================
# SatQuery AI - configuration
#
# Copy to .env and fill in what you have. Every value below has a working
# default, so an empty .env is valid: the only hard requirement for answering
# questions is that torch + transformers are installed so the practical
# BLIP/CLIP path can load.
#
#   cp .env.example .env
#   python -m satquery doctor
# ============================================================================


# ---------------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------------

# auto | cpu | cuda | mps.  auto picks CUDA, then MPS, then CPU.
SATQUERY_DEVICE=auto

# auto | float32 | float16 | bfloat16.
# auto uses float16 on CUDA and float32 elsewhere, because half precision on
# CPU is slow and thinly supported.
SATQUERY_DTYPE=auto

# Images per forward pass. Lower this first if you hit CUDA out-of-memory.
SATQUERY_BATCH_SIZE=16


# ---------------------------------------------------------------------------
# Practical vision backend (BLIP + CLIP)
#
# These download from HuggingFace on first use. Roughly 2 GB total for the
# defaults. Swap in smaller checkpoints if you are tight on disk or VRAM:
#   SATQUERY_CAPTION_MODEL=Salesforce/blip-image-captioning-base
#   SATQUERY_CLIP_MODEL=openai/clip-vit-base-patch32
# ---------------------------------------------------------------------------

SATQUERY_CAPTION_MODEL=Salesforce/blip-image-captioning-large
SATQUERY_VQA_MODEL=Salesforce/blip-vqa-base
SATQUERY_CLIP_MODEL=openai/clip-vit-large-patch14

SATQUERY_CAPTION_MAX_TOKENS=48
SATQUERY_VQA_MAX_TOKENS=24

# Needed only for gated or private repos.
# SATQUERY_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Where weights are cached. Point this at a volume with room.
# SATQUERY_HF_CACHE=/data/hf-cache

# Set true on an air-gapped machine once the weights are already cached.
SATQUERY_HF_LOCAL_ONLY=false


# ---------------------------------------------------------------------------
# Strong remote-sensing VLM (optional upgrade path)
#
# Point this at any domain vision-language checkpoint - a local directory or a
# HuggingFace repo id. When it loads, it takes over captioning and VQA; CLIP
# still handles grounding and classification. When it is absent, SatQuery uses
# the practical path with no change in behaviour.
# ---------------------------------------------------------------------------

SATQUERY_RSVLM_ENABLED=false
# SATQUERY_RSVLM_PATH=/data/checkpoints/rs-vlm

# auto | vision2seq | causal_lm | blip2 | geochat
# auto reads the checkpoint config and picks a loader class.
SATQUERY_RSVLM_KIND=auto

# GeoChat mode uses an externally installed GeoChat checkout; SatQuery does
# not vendor or modify that project. The checkpoint remains SATQUERY_RSVLM_PATH.
# SATQUERY_GEOCHAT_SOURCE_PATH=/opt/GeoChat
# SATQUERY_GEOCHAT_MODEL_BASE=
# SATQUERY_GEOCHAT_LOAD_8BIT=0
# SATQUERY_GEOCHAT_LOAD_4BIT=0

SATQUERY_RSVLM_MAX_TOKENS=320

# 0.0 gives deterministic beam search, which is what you want for a demo.
SATQUERY_RSVLM_TEMPERATURE=0.2

# Some community checkpoints ship custom modelling code and need this.
SATQUERY_RSVLM_TRUST_REMOTE_CODE=false

# SATQUERY_RSVLM_SYSTEM_PROMPT=You are a remote sensing image analyst...


# ---------------------------------------------------------------------------
# Query planning (optional)
#
# rules  - deterministic keyword routing. No API key, no network, no variance.
# hybrid - rules first, LLM consulted only when rules are unsure. (default)
# llm    - always ask the LLM. Requires a key.
#
# The planner only chooses which capability to run. It never sees the image and
# never writes the answer.
# ---------------------------------------------------------------------------

SATQUERY_ROUTER=hybrid

# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# SATQUERY_LLM_BASE_URL=https://api.openai.com/v1
# SATQUERY_LLM_MODEL=gpt-4o-mini
# SATQUERY_LLM_TIMEOUT=20


# ---------------------------------------------------------------------------
# Imagery handling
# ---------------------------------------------------------------------------

# Longest edge in pixels. Scenes above this are Lanczos-downsampled. Raising it
# improves small-object grounding and costs memory and time quadratically.
SATQUERY_MAX_IMAGE_PX=1536

SATQUERY_MAX_UPLOAD_MB=40

# Allow reading images from server-side paths (the /api/v1/query/json endpoint
# and the CLI). Set false for a public deployment.
SATQUERY_ALLOW_IMAGE_PATHS=true

# Sandbox root for path-based access. Strongly recommended if the above is on:
# relative paths resolve under it, and anything escaping it is refused.
# SATQUERY_IMAGE_ROOT=/data/scenes



# ---------------------------------------------------------------------------
# Grounding
# ---------------------------------------------------------------------------

# Window sizes as a fraction of the image's shorter edge. More and finer scales
# find smaller objects and cost proportionally more CLIP forward passes.
SATQUERY_GROUNDING_SCALES=0.5,0.35,0.25,0.18

# Hard cap on windows per query. This is the main latency dial.
SATQUERY_GROUNDING_MAX_WINDOWS=320

# Window overlap. 0.5 means each window overlaps its neighbour by half.
SATQUERY_GROUNDING_STRIDE_RATIO=0.5

# Response-map percentile used as the detection threshold.
SATQUERY_GROUNDING_PERCENTILE=88

# Regions smaller than this fraction of the response grid are discarded.
SATQUERY_GROUNDING_MIN_REGION_FRAC=0.0035

SATQUERY_GROUNDING_MAX_REGIONS=24


# ---------------------------------------------------------------------------
# Change detection
# ---------------------------------------------------------------------------

# Patch grid per side for semantic drift. 16 means 256 patches per epoch.
SATQUERY_CHANGE_PATCH_GRID=16

SATQUERY_CHANGE_MIN_REGION_FRAC=0.004


# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------

SATQUERY_HOST=127.0.0.1
SATQUERY_PORT=8000

# Number of tool results cached across requests. 0 disables caching.
SATQUERY_CACHE_SIZE=128

# Comma-separated origins. Leave blank to disable CORS entirely.
# SATQUERY_CORS_ORIGINS=http://localhost:3000
