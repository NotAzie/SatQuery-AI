.venv/
SAT_QUERY/.venv/

# Local environment settings; keep checked-in templates visible
.env
.env.*
!.env.example
!.env.*.example

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test and verification scratch output
.pytest_cache/
.pytest-*/
pytest-cache-files-*/
pytest-temp*/
pytest_temp*/
pytest-tmp*/
pytest-scratch-*/
satquery-execution-test-*/
SAT_QUERY_pytest_temp/
test-tmp-*/
platform-history-*/
.verify-tmp/
.verify-raster-tests/
.execution-test-*.sqlite
.earth-memory-*.sqlite
.earth-memory-config-*.sqlite

# Linters, coverage, and packaging/build output
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Local runtime state and logs (never source or reproducibility assets)
*.log
*.sqlite-shm
*.sqlite-wal
/SAT_QUERY/monitoring.sqlite
/SAT_QUERY/satquery-ai/monitoring.sqlite
/monitoring.sqlite
SAT_QUERY/satquery-ai/data/fetched_images/
/engine/satquery-ai/monitoring.sqlite
/engine/satquery-ai/.satquery/
/engine/satquery-ai/data/fetched_images/
