# Copy to .env (git-ignored). Secrets live here or in the real environment, never in config/*.yaml.

# Which configuration layers to load
EARTH_ENV=development
# EARTH_PROFILES=local-models          # comma-separated: local-models,hosted-apis

# SatQuery Engine Agent API
# EARTH_ENGINE__KIND=http
# EARTH_ENGINE__BASE_URL=http://localhost:9000
# EARTH_ENGINE__API_KEY_ENV=SATQUERY_API_KEY
# SATQUERY_API_KEY=
# EARTH_AGENT__MODEL_ID=<registered-engine-model-id>

# LLM provider keys (only for providers you enable)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Default model selection
# EARTH_LLM__DEFAULT_PROVIDER=
# EARTH_LLM__DEFAULT_MODEL=
