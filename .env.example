# Shared local configuration for SatQuery Engine, Platform API, and God's Eye.
# Copy this file to .env in the repository root:
#   C:\Users\mazin\SatQuery-AI\.env
# The root .env is git-ignored. Do not commit credentials.

# Platform -> Engine connection (Engine runs on port 9000 in INSTALL.md).
EARTH_ENGINE__KIND=http
EARTH_ENGINE__BASE_URL=http://127.0.0.1:9000

# Optional SatQuery Engine chat. Set these only after adding an OpenAI key.
# SATQUERY_AGENT_OPENAI_MODEL=gpt-4o-mini
# SATQUERY_AGENT_OPENAI_API_KEY=       # or use the OPENAI_API_KEY below
# SATQUERY_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# EARTH_AGENT__MODEL_ID=openai/gpt-4o-mini

# Bounded Engine Agent turn budgets (defaults shown).
# SATQUERY_PLATFORM__AGENT__MODEL_TIMEOUT_SECONDS=120
# SATQUERY_PLATFORM__AGENT__MAX_TOOL_ROUNDS=8
# SATQUERY_PLATFORM__AGENT__MAX_TOOL_CALLS_PER_TURN=24
# SATQUERY_PLATFORM__AGENT__MAX_CONTEXT_TURNS=24

# God's Eye browser-visible keys. Restrict these at their providers.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=

# God's Eye server-side provider keys (all optional).
GOOGLE_MAPS_SERVER_API_KEY=
OPENAI_API_KEY=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
LL2_API_TOKEN=

# Local integrated frontend and API proxy.
HOST=127.0.0.1
PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional backend provider keys.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# See APP/earth-view/.env.example for optional provider tuning and extra feeds.
# See engine/satquery-ai/.env.example for Engine runtime and vision settings.
# See APP/.env.example for additional Platform configuration.
